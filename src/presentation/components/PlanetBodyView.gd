@tool
class_name PlanetBodyView
extends Node2D
## Pixelated lit sphere, generated by a canvas shader: no external bitmap dependency.

const SPHERE_SHADER = preload("res://src/presentation/theme/planet_sphere.gdshader")
var palette: String = "earth"
var radius: float = 40.0
var _surface: ColorRect
var _material: ShaderMaterial


func _ready() -> void:
	_surface = ColorRect.new()
	_surface.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_surface.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	_material = ShaderMaterial.new()
	_material.shader = SPHERE_SHADER
	_surface.material = _material
	add_child(_surface)
	update_body(palette, radius, 0.0)


func update_body(body_palette: String, body_radius: float, time_s: float, light: Vector3 = Vector3(-0.65, -0.45, 0.65)) -> void:
	palette = body_palette
	radius = maxf(body_radius, 1.0)
	if _surface == null:
		return
	var extent: float = 1.22 if palette == "sun" else 1.10
	_surface.position = Vector2.ONE * -radius * extent
	_surface.size = Vector2.ONE * radius * extent * 2.0
	var body_type: int = {"earth": 0, "moon": 1, "mars": 2, "venus": 3, "sun": 4}.get(palette, 1)
	_material.set_shader_parameter("body_type", body_type)
	_material.set_shader_parameter("spin", time_s * (0.025 if body_type != 1 else 0.008))
	_material.set_shader_parameter("pixel_count", maxf(24.0, radius * 1.5))
	_material.set_shader_parameter("body_extent", extent)
	_material.set_shader_parameter("light_direction", light.normalized())
